log_format requestLogFormat "[$time_iso8601 - nginx::openresty $nginx_version] $server_name ($server_addr) $realpath_root => $proxy_add_x_forwarded_for:$remote_port ($server_protocol - $request_method) to $scheme://$host:$server_port$request_uri";
access_log /usr/local/openresty/nginx/logs/access.log requestLogFormat;

{% if reverse_proxy_enable_web_socket %}
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
{% endif %}

lua_shared_dict discovery {{ openid_cache_shared_memory_zone_mb }}m;
lua_ssl_verify_depth {{ openid_ssl_verify_depth }};
lua_ssl_trusted_certificate {{ openid_ssl_trusted_certificate }};

