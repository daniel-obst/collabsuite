server {
  listen {{ server_firewall_port }} ssl;

  server_name   {{ fqdn_server }};
  server_tokens off;

  ssl_certificate        {{ server_cert_file_path }};
  ssl_certificate_key    {{ server_key_file_path }};
  ssl_dhparam            {{ server_dh_file_path }};
  ssl_client_certificate {{ server_ca_cert_file_path }};

  resolver {{ service_network_dns }} valid=5s;
  resolver_timeout 5s;

  #ssl_protocols             TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers               EECDH+AESGCM:EDH+AESGCM;
  ssl_ecdh_curve            secp384r1;
  ssl_session_timeout       10m;
  ssl_session_cache         shared:SSL:10m;
  ssl_session_tickets       off;
  ssl_stapling              off;
  ssl_stapling_verify       on;
  ssl_trusted_certificate   {{ ssl_ca_certificates_path }};
  ssl_ocsp                  off;

  # Disable strict transport security for now. You can uncomment the following
  # line if you understand the implications.
  #add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload";

  # X-Frame-Options (deprecated): https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-Frame-Options
  # X-XSS-Protection (non-standard): https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-XSS-Protection

  # add_header 'Access-Control-Allow-Origin' 'https:// domain ';
  add_header X-Content-Type-Options nosniff;

  # Disable site caching
  expires    0;
  add_header Cache-Control private;

  root /usr/local/openresty/nginx/html;

  # openID configuration
  access_by_lua_block {
    local opts = {
      redirect_uri = "{{ openid_redirect_uri }}",
      discovery = "{{ openid_discovery_uri }}",
      token_endpoint_auth_method = client_secret_post,
      client_id = "{{ openid_client_id }}",
      client_secret = "{{ lookup('openid_client_password', openid_client_secret_file_path) }}",
      ssl_verify = "true",
      redirect_uri_scheme = "https",
      logout_path = "/logout",
      response_mode = form_post,
      use_nonce = true,
      revoke_tokens_on_logout = true,
      scope = "openid email profile",
      renew_access_token_on_expiry = true,
      access_token_expires_in = 3660,
      accept_unsupported_alg = false,
      accept_none_alg = false,
      session_contents = { id_token = true }
    }

    -- call introspect for OAuth 2.0 Bearer Access Token validation
{% if openid_client_enable_login %}
    -- decision: redirect any unauthenticated requests to openid login
    local res, err = require("resty.openidc").authenticate(opts)

    if err then
      ngx.status = ngx.HTTP_FORBIDDEN
      ngx.log(ngx.ERR, err)
      ngx.exit(ngx.HTTP_FORBIDDEN)
    end

    ngx.req.set_header("{{ openid_http_header_email }}", res.id_token.email)
    ngx.req.set_header("{{ openid_http_header_authorization }}", res.id_token.sub)
{% endif %}
  }

{% if deny_root_uri_location %}
  location ~* ^/$ {
    return 403;
  }

{% endif %}
  include {{ includes_locations_config_path }};

  include {{ includes_html_error_pages_conf_path }};
}